<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#312E81</color>
    <color name="brand_dark">#1E1B4B</color>
    <color name="icon_bg">#4F46E5</color>

    <!-- Dark platform theme so status bar icons are light on the indigo header. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:colorAccent">@color/icon_bg</item>
    </style>
</resources>
