rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each account remembers which family it belongs to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One document per family. The document id is the family code.
    match /households/{code} {
      // Start a family: you must be its only member.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // Members can read and edit the shared plan.
      allow get, update: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Join with the code: a signed-in person may add themselves, and nothing else.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 6
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']);

      // Nobody can list families or delete one from the app.
    }
  }
}
